{
  "name": "cobblestone-ai-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation-driven prompt development for three restaurant AI systems: a support assistant, a regulation Q&A engine, and a self-checking receipt extractor.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "eval": "tsx harness/cli.ts run",
    "report": "tsx harness/cli.ts report",
    "baton": "tsx scripts/baton.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test harness/tests/*.test.ts 0*/*.test.ts",
    "scan": "tsx scripts/scan.ts",
    "check": "npm run typecheck && npm test && npm run scan",
    "setup-hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
